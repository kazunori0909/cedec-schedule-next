# HTML は毎回サーバーに確認させる（キャッシュを使わない）
<FilesMatch "\.(html|htm)$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# JS / CSS / フォント / 画像はハッシュ付きファイル名なので長期キャッシュ可
<FilesMatch "\.(js|css|woff2?|ttf|otf|eot|ico|png|jpg|jpeg|gif|svg|webp)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
